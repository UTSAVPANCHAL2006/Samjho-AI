# Copy to backend/.env and fill in. Never commit .env. Everything works without keys in a safe offline mode.

DATABASE_URL=postgresql+psycopg://homi:homi@localhost:5432/samjho
# Frontend addresses allowed to call the API, comma-separated (add your Vercel URL when deployed).
CORS_ORIGINS=http://localhost:3000

# AI models. Tried in order: TEXT_MODELS / VISION_MODELS in app/config.py; a provider without a key is skipped.
# Optional but recommended for demos: OpenAI reads photos first (free tiers throttle under a burst of photos).
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Voice: "sarvam" for Indian-accent STT/TTS (uses credits), "browser" for the browser's own speech.
SPEECH_PROVIDER=browser
SARVAM_API_KEY=
